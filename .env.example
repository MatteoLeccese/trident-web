# Trident web — copy this to `.env` and the app comes up as it is.
#
#     cp .env.example .env && docker compose up -d --build
#
# Bring the API stack up first: this app joins the network that one owns.
#
# Every value below is filled in and works against the API on this machine.
# Only the Reverb host normally needs changing, and only to play on a LAN.
#
# ─── What gets baked in, and what does not ────────────────────────────────────
#
# Anything named NEXT_PUBLIC_* is INLINED INTO THE BUNDLE AT BUILD TIME. Setting
# one on a running container changes nothing at all. The compose file passes them
# as build arguments for exactly this reason, so changing one means:
#
#     docker compose up -d --build
#
# Everything without that prefix is read on the server at run time and never
# reaches the browser.

# ─── BFF → backend ────────────────────────────────────────────────────────────
# NO NEXT_PUBLIC_ PREFIX, deliberately: the browser must never learn this. Every
# request the browser makes goes to this app, and this app talks to Laravel.
#
# `api` is the container name inside the stack; use http://127.0.0.1:8000/api/v1
# when running `npm run dev` on this machine instead.

BACKEND_API_URL=http://api:8000/api/v1

# ─── Browser ──────────────────────────────────────────────────────────────────

# How long the browser waits on one request before calling it a timeout. A write
# that times out is retried with the same request id, so this is the delay before
# that starts, not the delay before somebody gives up.
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Must match REVERB_APP_KEY on the API side.
NEXT_PUBLIC_REVERB_APP_KEY=trident-local

# CHANGE FOR A REAL EVENING, or leave it empty.
#
# Empty means the browser connects to the socket on the host it loaded the page
# from, which is right almost always and survives the LAN address changing. Set
# it only when the socket lives somewhere other than the web app.
NEXT_PUBLIC_REVERB_HOST=

NEXT_PUBLIC_REVERB_PORT=8080

# How often the television asks the server again, whatever its socket claims.
# It is what saves the big screen from a socket that died quietly. Empty keeps
# the shipped 30 seconds.
NEXT_PUBLIC_TRIDENT_RECONCILE_POLL_MS=
