# ─── BFF → backend ────────────────────────────────────────────────────────────
# SIN prefijo NEXT_PUBLIC_: esta variable no debe llegar nunca al navegador.
# En local, apunta al `php artisan serve` o al contenedor de la API.
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# ─── Navegador ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Reverb, en red local: ws:// plano contra la IP LAN de esta máquina.
# No hay certificado que aceptar, que era el problema que teníamos con el televisor.
NEXT_PUBLIC_REVERB_APP_KEY=trident-local
NEXT_PUBLIC_REVERB_HOST=192.168.1.10
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Gemelos de config/trident.php en el backend. Si cambias uno, cambia el otro.
NEXT_PUBLIC_TRIDENT_MIN_PLAYERS=3
NEXT_PUBLIC_TRIDENT_MAX_PLAYERS=15
NEXT_PUBLIC_TRIDENT_NICKNAME_MIN=2
NEXT_PUBLIC_TRIDENT_NICKNAME_MAX=24
NEXT_PUBLIC_TRIDENT_RECONCILE_POLL_MS=30000
